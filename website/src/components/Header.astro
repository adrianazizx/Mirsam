---
import { Download, Languages } from "@lucide/astro";
import { homePath, type Lang, strings } from "../lib/i18n";

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = strings[lang];
const other: Lang = lang === "ar" ? "en" : "ar";
const links = [
  { href: "#features", label: t.nav.features },
  { href: "#arabic", label: t.nav.arabic },
  { href: "#ocr", label: t.nav.ocr },
  { href: "#privacy", label: t.nav.privacy },
];
---

<header class="header" data-header>
  <div class="container header-inner">
    <a class="brand" href={homePath(lang)}>
      <img src="/favicon.svg" alt="" width="26" height="35" />
      <span class="brand-name">
        <span lang="en">Mirsam</span>
        <span class="brand-ar" lang="ar">مرسام</span>
      </span>
    </a>
    <nav class="nav" aria-label={t.nav.menu}>
      <ul>
        {links.map((link) => <li><a href={link.href} data-nav-link>{link.label}</a></li>)}
      </ul>
    </nav>
    <div class="header-actions">
      <a class="lang-switch" href={homePath(other)} hreflang={other} lang={other} aria-label={t.nav.switchLabel} data-lang-switch>
        <Languages aria-hidden="true" />
        <span>{t.nav.switchText}</span>
      </a>
      <a class="button button-primary header-cta" href="#download">
        <Download aria-hidden="true" />
        <span>{t.nav.download}</span>
      </a>
    </div>
  </div>
</header>

<style>
  .header {
    position: fixed;
    inset-block-start: 0;
    inset-inline: 0;
    z-index: 50;
    block-size: var(--header-h);
    transition:
      background-color var(--dur-med) var(--ease-out),
      border-color var(--dur-med) var(--ease-out),
      backdrop-filter var(--dur-med) var(--ease-out);
    border-block-end: 1px solid transparent;
  }

  .header.is-scrolled {
    background: rgb(var(--bg-rgb) / 0.8);
    border-block-end-color: var(--border);
    backdrop-filter: blur(18px) saturate(140%);
    -webkit-backdrop-filter: blur(18px) saturate(140%);
  }

  .header-inner {
    display: flex;
    align-items: center;
    gap: 24px;
    block-size: 100%;
  }

  .brand {
    display: inline-flex;
    align-items: center;
    gap: 12px;
    color: var(--fg);
    text-decoration: none;
  }

  .brand img {
    inline-size: auto;
    block-size: 35px;
  }

  .brand-name {
    display: inline-flex;
    align-items: baseline;
    gap: 8px;
    font-family: var(--font-display);
    font-size: 1.3rem;
    font-weight: 600;
    letter-spacing: -0.01em;
  }

  .brand-ar {
    color: var(--accent);
    font-family: var(--font-display);
    font-size: 1.15rem;
    font-weight: 500;
  }

  .nav {
    margin-inline-start: auto;
  }

  .nav ul {
    display: flex;
    gap: 4px;
  }

  .nav a {
    display: inline-block;
    padding: 8px 14px;
    border-radius: var(--radius-full);
    color: var(--fg-muted);
    font-size: var(--step--1);
    font-weight: 500;
    text-decoration: none;
    transition:
      color var(--dur-fast),
      background-color var(--dur-fast);
  }

  :global(:lang(ar)) .nav a {
    font-size: var(--step-0);
  }

  .nav a:hover,
  .nav a.is-current {
    color: var(--fg);
    background: rgb(var(--fg-rgb) / 0.06);
  }

  .header-actions {
    display: flex;
    align-items: center;
    gap: 10px;
  }

  .lang-switch {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    min-block-size: 44px;
    padding-inline: 14px;
    border: 1px solid var(--border);
    border-radius: var(--radius-full);
    color: var(--fg);
    font-weight: 500;
    text-decoration: none;
  }

  .lang-switch:lang(ar) {
    font-family: "IBM Plex Sans Arabic", sans-serif;
  }

  .lang-switch:lang(en) {
    font-family: "IBM Plex Sans", sans-serif;
  }

  .lang-switch:hover {
    border-color: var(--border-strong);
    color: var(--fg);
  }

  .lang-switch svg {
    inline-size: 18px;
    block-size: 18px;
    color: var(--accent);
  }

  .header-cta {
    min-block-size: 44px;
    padding-inline: 18px;
  }

  @media (max-width: 900px) {
    .nav {
      display: none;
    }

    .header-actions {
      margin-inline-start: auto;
    }
  }

  @media (max-width: 480px) {
    .header-inner {
      gap: 12px;
    }

    .brand-ar {
      display: none;
    }

    .header-cta span {
      position: absolute;
      inline-size: 1px;
      block-size: 1px;
      overflow: hidden;
      clip-path: inset(50%);
      white-space: nowrap;
    }

    .header-cta {
      padding-inline: 13px;
    }
  }
</style>
