---
import { Download as DownloadIcon, FileCheck, Laptop, Package, ShieldCheck, Terminal } from "@lucide/astro";
import { fill, formatNumber, type Lang, strings } from "../lib/i18n";
import { DOCS_URL, downloadUrl, RELEASES_URL, release } from "../lib/release";

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = strings[lang].download;
const version = `<bdi dir="ltr">${release.version}</bdi>`;
const size = (file: string) => {
  const bytes = release.sizes[file];
  if (!bytes) return null;
  return `${formatNumber(lang, bytes / 1_000_000)} ${lang === "ar" ? "م.ب" : "MB"}`;
};
---

<section class="section download band-dark" id="download">
  <div class="download-glow" aria-hidden="true"></div>
  <div class="container">
    <header class="download-head">
      <p class="kicker" data-reveal>{t.kicker}</p>
      <h2 class="section-title" data-reveal style="--d: 1" set:html={fill(t.title, { version })} />
      <p class="section-lede" data-reveal style="--d: 2">{t.lede}</p>
    </header>

    <ul class="platforms">
      {
        t.platforms.map((platform, i) => {
          const [primary, ...others] = platform.files;
          return (
            <li class="platform" data-platform={platform.id} data-reveal style={`--d: ${i}`}>
              <span class="badge">{t.recommended}</span>
              <span class="platform-icon">
                {platform.id === "mac" && <Laptop aria-hidden="true" />}
                {platform.id === "windows" && (
                  <svg viewBox="0 0 24 24" aria-hidden="true">
                    <path d="M3 5.5 10.5 4.4v7.1H3zM12 4.2 21 3v8.5h-9zM3 12.5h7.5v7.1L3 18.5zM12 12.5h9V21l-9-1.2z" fill="currentColor" />
                  </svg>
                )}
                {platform.id === "linux" && <Terminal aria-hidden="true" />}
              </span>
              <h3>{platform.name}</h3>
              <p class="requirements">{platform.requirements}</p>
              {primary && (
                <a class="button button-primary file-primary" href={downloadUrl(primary.file)} download>
                  <DownloadIcon aria-hidden="true" />
                  <span>{primary.label}</span>
                  <span class="file-kind" dir="ltr">{primary.kind}</span>
                </a>
              )}
              {primary && size(primary.file) && <p class="file-size">{size(primary.file)}</p>}
              {others.length > 0 && (
                <ul class="file-others">
                  {others.map((file) => (
                    <li>
                      <a href={downloadUrl(file.file)} download>
                        <span>{file.label}</span>
                        <span class="file-kind" dir="ltr">{file.kind}</span>
                        {size(file.file) && <span class="file-size-inline">{size(file.file)}</span>}
                      </a>
                    </li>
                  ))}
                </ul>
              )}
              <details class="install">
                <summary>{t.installLabel}</summary>
                <p>{platform.install}</p>
              </details>
            </li>
          );
        })
      }
    </ul>

    <p class="ocr-note" data-reveal>{t.ocrNote}</p>

    <ul class="download-links" data-reveal>
      <li>
        <a href={downloadUrl("SHA256SUMS.txt")}><FileCheck aria-hidden="true" />{t.checksums}</a>
      </li>
      <li>
        <a href={`${DOCS_URL}/CODE_SIGNING_POLICY.md`}><ShieldCheck aria-hidden="true" />{t.signing}</a>
      </li>
      <li>
        <a href={RELEASES_URL}><Package aria-hidden="true" />{t.allReleases}</a>
      </li>
    </ul>
  </div>
</section>

<style>
  .download {
    overflow: clip;
  }

  .download-glow {
    position: absolute;
    inset-block-end: -200px;
    inset-inline-start: 50%;
    inline-size: 1200px;
    block-size: 700px;
    translate: -50% 0;
    background: radial-gradient(closest-side, rgb(var(--accent-rgb) / 0.35), transparent);
    filter: blur(30px);
    pointer-events: none;
  }

  :global([dir="rtl"]) .download-glow {
    translate: 50% 0;
  }

  .download-head {
    position: relative;
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
  }

  .download-head .section-title {
    max-inline-size: none;
  }

  .platforms {
    position: relative;
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 300px), 1fr));
    gap: 20px;
    margin-block-start: 64px;
  }

  .platform {
    position: relative;
    display: flex;
    flex-direction: column;
    padding: 32px 28px 24px;
    border: 1px solid var(--border);
    border-radius: var(--radius-xl);
    background: linear-gradient(180deg, var(--surface), var(--bg));
    transition:
      border-color var(--dur-med),
      box-shadow var(--dur-med),
      transform var(--dur-med) var(--ease-out);
  }

  .platform:hover {
    border-color: var(--border-strong);
    transform: translateY(-4px);
  }

  .platform.is-recommended {
    border-color: rgb(var(--accent-rgb) / 0.5);
    box-shadow: var(--glow);
  }

  .badge {
    position: absolute;
    inset-block-start: 20px;
    inset-inline-end: 20px;
    display: none;
    padding: 4px 12px;
    border-radius: var(--radius-full);
    background: var(--accent);
    color: var(--on-accent);
    font-size: 0.78rem;
    font-weight: 700;
  }

  .is-recommended .badge {
    display: inline-block;
  }

  .platform-icon {
    display: grid;
    place-items: center;
    inline-size: 60px;
    block-size: 60px;
    border-radius: 18px;
    background: rgb(var(--accent-rgb) / 0.12);
    color: var(--accent);
  }

  .platform-icon :global(svg) {
    inline-size: 30px;
    block-size: 30px;
  }

  .platform h3 {
    margin-block-start: 22px;
    font-size: var(--step-2);
  }

  .requirements {
    margin-block-start: 6px;
    color: var(--fg-dim);
    font-size: var(--step--1);
  }

  .file-primary {
    margin-block-start: 26px;
    inline-size: 100%;
  }

  .file-kind {
    padding: 2px 8px;
    border-radius: var(--radius-full);
    background: rgb(var(--fg-rgb) / 0.18);
    font-family: var(--font-mono);
    font-size: 0.78rem;
    font-weight: 500;
  }

  .file-size {
    margin-block-start: 8px;
    color: var(--fg-dim);
    font-size: var(--step--1);
    text-align: center;
  }

  .file-others {
    display: grid;
    gap: 8px;
    margin-block-start: 14px;
  }

  .file-others a {
    display: flex;
    align-items: center;
    gap: 10px;
    min-block-size: 46px;
    padding-inline: 16px;
    border: 1px solid var(--border);
    border-radius: var(--radius-full);
    color: var(--fg);
    font-weight: 500;
    text-decoration: none;
    transition:
      border-color var(--dur-fast),
      background-color var(--dur-fast);
  }

  .file-others a:hover {
    border-color: var(--border-strong);
    background: rgb(var(--fg-rgb) / 0.04);
  }

  .file-others .file-kind {
    margin-inline-start: auto;
    background: rgb(var(--fg-rgb) / 0.06);
    color: var(--fg-muted);
  }

  .file-size-inline {
    color: var(--fg-dim);
    font-size: 0.78rem;
  }

  .install {
    margin-block-start: auto;
    padding-block-start: 22px;
    color: var(--fg-muted);
    font-size: var(--step--1);
  }

  .install summary {
    cursor: pointer;
    color: var(--fg-muted);
    font-weight: 600;
  }

  .install summary:hover {
    color: var(--fg);
  }

  .install p {
    margin-block-start: 10px;
    line-height: 1.6;
  }

  :global(:lang(ar)) .install {
    font-size: var(--step-0);
  }

  .ocr-note {
    position: relative;
    margin-block-start: 40px;
    color: var(--fg-muted);
    text-align: center;
  }

  .download-links {
    position: relative;
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 12px 32px;
    margin-block-start: 24px;
  }

  .download-links a {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    font-weight: 500;
  }

  .download-links :global(svg) {
    inline-size: 18px;
    block-size: 18px;
  }
</style>
