---
import {
  BookOpen,
  Check,
  FileOutput,
  Highlighter,
  LayoutGrid,
  PenLine,
  ScanText,
  Search,
  ShieldCheck,
  Signature,
} from "@lucide/astro";
import { fill, type Lang, strings } from "../lib/i18n";
import { release } from "../lib/release";
import Shot from "./Shot.astro";

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = strings[lang].features;
const version = `<bdi dir="ltr">${release.version}</bdi>`;
const chapterIcons = {
  read: BookOpen,
  search: Search,
  annotate: Highlighter,
  organize: LayoutGrid,
  edit: PenLine,
  forms: Signature,
  protect: ShieldCheck,
  convert: FileOutput,
} as const;
const gridIcons = [BookOpen, Highlighter, PenLine, Signature, ScanText, FileOutput];
const number = (n: number) =>
  new Intl.NumberFormat(lang === "ar" ? "ar-u-nu-arab" : "en", { minimumIntegerDigits: 2 }).format(n);
---

<section class="section features" id="features">
  <div class="container">
    <header class="features-head">
      <p class="kicker" data-reveal>{t.kicker}</p>
      <h2 class="section-title" data-reveal style="--d: 1">{t.title}</h2>
      <p class="section-lede" data-reveal style="--d: 2" set:html={fill(t.lede, { version })} />
    </header>

    <div class="story" data-story>
      <ol class="chapters">
        {
          t.chapters.map((chapter, i) => {
            const Icon = chapterIcons[chapter.id as keyof typeof chapterIcons];
            return (
              <li class="chapter" data-chapter={chapter.id} id={`feature-${chapter.id}`}>
                <div class="chapter-inner" data-reveal>
                  <p class="chapter-kicker">
                    <span class="chapter-icon">
                      <Icon aria-hidden="true" />
                    </span>
                    <span class="chapter-number">{number(i + 1)}</span>
                    <span>{chapter.kicker}</span>
                  </p>
                  <h3 class="chapter-title">{chapter.title}</h3>
                  <p class="chapter-body">{chapter.body}</p>
                  <ul class="chapter-points">
                    {chapter.points.map((point) => (
                      <li>
                        <Check aria-hidden="true" />
                        <span>{point}</span>
                      </li>
                    ))}
                  </ul>
                  <div class="chapter-shot">
                    <Shot id={chapter.shot} lang={lang} alt={chapter.alt} />
                  </div>
                </div>
              </li>
            );
          })
        }
      </ol>
      <div class="story-stage" aria-hidden="true">
        <div class="story-frame" data-story-frame>
          {
            t.chapters.map((chapter, i) => (
              <div class:list={["story-slide", i === 0 && "is-active"]} data-slide={chapter.id}>
                <Shot id={chapter.shot} lang={lang} alt="" />
              </div>
            ))
          }
        </div>
        <ol class="story-progress">
          {t.chapters.map((chapter, i) => <li class:list={[i === 0 && "is-active"]} data-dot={chapter.id} />)}
        </ol>
      </div>
    </div>

    <div class="grid-block">
      <p class="kicker" data-reveal set:html={fill(t.gridKicker, { version })} />
      <h3 class="grid-title" data-reveal style="--d: 1">{t.gridTitle}</h3>
      <ul class="grid">
        {
          t.grid.map((group, i) => {
            const Icon = gridIcons[i];
            return (
              <li class="card" data-reveal style={`--d: ${i % 3}`} data-glow>
                <span class="card-icon">{Icon && <Icon aria-hidden="true" />}</span>
                <h4>{group.title}</h4>
                <ul>
                  {group.items.map((item) => (
                    <li>{item}</li>
                  ))}
                </ul>
              </li>
            );
          })
        }
      </ul>
    </div>
  </div>
</section>

<style>
  .features-head {
    max-inline-size: 820px;
  }

  .story {
    display: grid;
    grid-template-columns: minmax(0, 5fr) minmax(0, 7fr);
    gap: clamp(32px, 5vw, 80px);
    margin-block-start: clamp(48px, 8vw, 120px);
  }

  .chapter {
    display: flex;
    align-items: center;
    min-block-size: 78vh;
  }

  .chapter:first-child {
    min-block-size: 60vh;
    align-items: flex-start;
  }

  .chapter-kicker {
    display: flex;
    align-items: center;
    gap: 12px;
    color: var(--accent);
    font-weight: 600;
  }

  .chapter-icon {
    display: grid;
    place-items: center;
    inline-size: 40px;
    block-size: 40px;
    border: 1px solid var(--border-strong);
    border-radius: 12px;
    background: linear-gradient(160deg, rgb(var(--accent-rgb) / 0.16), transparent);
  }

  .chapter-icon :global(svg) {
    inline-size: 20px;
    block-size: 20px;
  }

  .chapter-number {
    color: var(--fg-dim);
    font-family: var(--font-mono);
    font-size: var(--step--1);
  }

  .chapter-title {
    margin-block-start: 20px;
    font-size: var(--step-3);
  }

  .chapter-body {
    margin-block-start: 18px;
    color: var(--fg-muted);
    font-size: var(--step-1);
    line-height: 1.55;
  }

  .chapter-points {
    display: grid;
    gap: 10px;
    margin-block-start: 26px;
  }

  .chapter-points li {
    display: flex;
    gap: 12px;
    align-items: flex-start;
  }

  .chapter-points :global(svg) {
    flex: none;
    inline-size: 20px;
    block-size: 20px;
    margin-block-start: 0.25em;
    color: var(--accent);
  }

  .chapter-shot {
    display: none;
  }

  .story-stage {
    position: sticky;
    inset-block-start: calc(var(--header-h) + 8vh);
    align-self: start;
    block-size: fit-content;
  }

  .story-frame {
    position: relative;
    display: grid;
  }

  .story-slide {
    grid-area: 1 / 1;
    opacity: 0;
    transform: translateY(24px) scale(0.97);
    transition:
      opacity 700ms var(--ease-out),
      transform 900ms var(--ease-out);
  }

  .story-slide.is-active {
    opacity: 1;
    transform: none;
  }

  .story-progress {
    display: flex;
    justify-content: center;
    gap: 8px;
    margin: 24px 0 0;
    padding: 0;
    list-style: none;
  }

  .story-progress li {
    inline-size: 8px;
    block-size: 8px;
    border-radius: var(--radius-full);
    background: var(--border-strong);
    transition:
      inline-size var(--dur-med) var(--ease-out),
      background-color var(--dur-med);
  }

  .story-progress li.is-active {
    inline-size: 32px;
    background: var(--accent);
  }

  @media (max-width: 960px) {
    .story {
      grid-template-columns: minmax(0, 1fr);
    }

    .story-stage {
      display: none;
    }

    .chapter,
    .chapter:first-child {
      min-block-size: 0;
      padding-block: 40px;
    }

    .chapter-shot {
      display: block;
      margin-block-start: 32px;
    }
  }

  /* Grid */
  .grid-block {
    margin-block-start: var(--section);
  }

  .grid-title {
    font-size: var(--step-3);
  }

  .grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 300px), 1fr));
    gap: 18px;
    margin-block-start: 40px;
  }

  .card {
    position: relative;
    padding: 28px;
    border: 1px solid var(--border);
    border-radius: var(--radius-lg);
    background:
      radial-gradient(400px 200px at var(--gx, 50%) var(--gy, 0%), rgb(var(--accent-rgb) / 0.12), transparent 70%),
      linear-gradient(180deg, var(--surface), var(--bg));
    transition: border-color var(--dur-med);
  }

  .card:hover {
    border-color: var(--border-strong);
  }

  .card-icon {
    display: grid;
    place-items: center;
    inline-size: 48px;
    block-size: 48px;
    border-radius: 14px;
    background: rgb(var(--accent-rgb) / 0.12);
    color: var(--accent);
  }

  .card-icon :global(svg) {
    inline-size: 24px;
    block-size: 24px;
  }

  .card h4 {
    margin-block-start: 20px;
    font-size: var(--step-1);
    font-weight: 600;
  }

  .card ul {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    margin-block-start: 16px;
  }

  .card ul li {
    padding: 5px 12px;
    border: 1px solid var(--border);
    border-radius: var(--radius-full);
    color: var(--fg-muted);
    font-size: var(--step--1);
  }
</style>
