---
import { Cloud, Cpu, Eye, FileText, Lock, ScanSearch, Sparkles, UserCheck, UserX, WifiOff, X, Zap } from "@lucide/astro";
import { type Lang, strings } from "../lib/i18n";
import Shot from "./Shot.astro";

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = strings[lang].ocr;

// The scan is a page from the OCR evaluation set (ocr-eval/, generated, a
// photocopy-style degradation); these are its lines as text. Two words are
// shown flagged for review, as the review list would.
const FLAGGED = ["INV-2026-00417", "١٢٣٤"];
const lines = [
  "نص مختلط — Mixed text",
  "اشتريت 3 أجهزة iPhone 15 Pro بسعر 4,500 ريال (شاملة الضريبة).",
  "رقم الفاتورة INV-2026-00417 بتاريخ 12/03/2026، والمبلغ الإجمالي 13,500.75 ريال.",
  "للتواصل: support@example.com أو هاتف +966 11 234 5678 (من 9 ص إلى 5 م).",
  "صدر القرار رقم ١٢٣٤ لسنة ٢٠٢٥ في ١٥ مادة.",
  "هل تستخدم برنامج Adobe Acrobat؟ نعم، الإصدار 2024 (64-bit)!",
  "The Arabic word for page is صفحة (safha), and the plural is صفحات.",
  "Clause 4.2 refers to the “عقد الإيجار” dated 12 March 2026 (ref. SA-417).",
];
const split = (line: string) => {
  const flagged = FLAGGED.find((word) => line.includes(word));
  if (!flagged) return { before: line, flagged: null, after: "" };
  const [before, after] = line.split(flagged);
  return { before, flagged, after };
};
const stepIcons = [Zap, Sparkles, ScanSearch, UserCheck];
const pointIcons = [WifiOff, Lock, UserX, Eye];
---

<section class="section ocr band-dark" id="ocr">
  <div class="ocr-aurora" aria-hidden="true"></div>
  <div class="container">
    <header class="ocr-head">
      <p class="kicker" data-reveal>{t.kicker}</p>
      <h2 class="section-title ocr-title" data-reveal style="--d: 1">{t.title}</h2>
      <p class="section-lede" data-reveal style="--d: 2">{t.lede}</p>
    </header>

    <figure class="scan-demo" data-scan aria-label={t.demoLabel} data-reveal="scale">
      <div class="scan-pane">
        <span class="pane-tag">{t.demoScan}</span>
        <div class="scan-image">
          <img src="/ocr/scan.webp" alt="" width="1100" height="765" loading="lazy" decoding="async" />
          <div class="scan-done" aria-hidden="true"></div>
          <div class="beam" aria-hidden="true"></div>
        </div>
      </div>
      <div class="text-pane">
        <span class="pane-tag pane-tag-text">{t.demoText}</span>
        <ol class="ocr-lines" dir="rtl" lang="ar">
          {
            lines.map((line, i) => {
              const { before, flagged, after } = split(line);
              return (
                <li style={`--i: ${i}`} dir="auto">
                  {before}
                  {flagged && <mark title={t.demoReview}>{flagged}</mark>}
                  {after}
                </li>
              );
            })
          }
        </ol>
        <p class="review-chip"><span aria-hidden="true"></span>{t.demoReview}</p>
      </div>
    </figure>

    <div class="how">
      <h3 class="how-title" data-reveal>{t.howTitle}</h3>
      <ol class="pipeline" data-pipeline>
        <span class="pipeline-line" aria-hidden="true"><span></span></span>
        {
          t.steps.map((step, i) => {
            const Icon = stepIcons[i];
            return (
              <li class="step" data-reveal style={`--d: ${i}`}>
                <span class="step-icon">{Icon && <Icon aria-hidden="true" />}</span>
                <h4>{step.title}</h4>
                <p>{step.body}</p>
              </li>
            );
          })
        }
      </ol>
    </div>

    <div class="secure">
      <div class="secure-diagram" role="img" aria-label={t.diagramLabel} data-reveal="scale">
        <div class="laptop">
          <div class="laptop-screen">
            <span class="laptop-label"><Lock aria-hidden="true" />{t.diagramLaptop}</span>
            <div class="node node-doc">
              <FileText aria-hidden="true" />
              <span>{t.diagramDoc}</span>
            </div>
            <div class="flow" aria-hidden="true">
              <span></span><span></span><span></span>
            </div>
            <div class="node node-model">
              <Cpu aria-hidden="true" />
              <span>{t.diagramModel}</span>
            </div>
          </div>
          <div class="laptop-base" aria-hidden="true"></div>
        </div>
        <div class="cut" aria-hidden="true">
          <span class="cut-line"></span>
          <span class="cut-x"><X /></span>
          <span class="cut-label">{t.diagramZero}</span>
        </div>
        <div class="cloud">
          <Cloud aria-hidden="true" />
          <span>{t.diagramCloud}</span>
        </div>
      </div>

      <div class="secure-text">
        <p class="kicker" data-reveal>{t.secureKicker}</p>
        <h3 class="secure-title" data-reveal style="--d: 1">{t.secureTitle}</h3>
        <p class="secure-body" data-reveal style="--d: 2">{t.secureBody}</p>
        <ul class="secure-points">
          {
            t.securePoints.map((point, i) => {
              const Icon = pointIcons[i];
              return (
                <li data-reveal style={`--d: ${i + 2}`}>
                  <span class="point-icon">{Icon && <Icon aria-hidden="true" />}</span>
                  <div>
                    <h4>{point.title}</h4>
                    <p>{point.body}</p>
                  </div>
                </li>
              );
            })
          }
        </ul>
      </div>
    </div>

    <ul class="stats">
      {
        t.stats.map((stat, i) => (
          <li data-reveal style={`--d: ${i}`}>
            <span class="stat-value">{stat.value}</span>
            <span class="stat-label">{stat.label}</span>
          </li>
        ))
      }
    </ul>

    <div class="ocr-shot">
      <p class="accuracy" data-reveal>{t.accuracyNote}</p>
      <div data-reveal="scale">
        <Shot id="ocr" lang={lang} alt={t.shotAlt} />
      </div>
    </div>
  </div>
</section>

<style>
  .ocr {
    overflow: clip;
  }

  .ocr-aurora {
    position: absolute;
    inset-block-start: 0;
    inset-inline: 0;
    block-size: 900px;
    background:
      radial-gradient(600px 300px at 20% 10%, rgb(var(--accent-rgb) / 0.18), transparent 70%),
      radial-gradient(500px 300px at 85% 30%, rgb(var(--accent-rgb) / 0.12), transparent 70%);
    filter: blur(20px);
    pointer-events: none;
  }

  .ocr-head {
    position: relative;
    max-inline-size: 900px;
  }

  .ocr-title {
    max-inline-size: 20ch;
  }

  /* The scan demo: main.ts sets --p (0 to 1) as it scrolls through. */
  /* Without the script, everything shows in its finished state. */
  .scan-demo {
    --p: 1;
    position: relative;
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
    gap: 2px;
    margin: clamp(48px, 7vw, 96px) 0 0;
    overflow: hidden;
    border: 1px solid var(--border-strong);
    border-radius: var(--radius-lg);
    background: var(--border);
    box-shadow: var(--shadow-window);
  }

  .scan-pane,
  .text-pane {
    position: relative;
    padding: clamp(20px, 3vw, 36px);
    background: var(--surface);
  }

  .pane-tag {
    display: inline-block;
    margin-block-end: 16px;
    padding: 4px 12px;
    border-radius: var(--radius-full);
    background: rgb(var(--fg-rgb) / 0.06);
    color: var(--fg-muted);
    font-size: var(--step--1);
    font-weight: 600;
  }

  .pane-tag-text {
    background: rgb(var(--accent-rgb) / 0.14);
    color: var(--accent);
  }

  .scan-image {
    position: relative;
    overflow: hidden;
    border-radius: var(--radius-sm);
  }

  .scan-image img {
    inline-size: 100%;
    filter: grayscale(0.2) contrast(1.05);
  }

  /* The part of the page already read gets a lavender wash. */
  .scan-done {
    position: absolute;
    inset: 0;
    background: linear-gradient(180deg, rgb(var(--accent-rgb) / 0.16), rgb(var(--accent-rgb) / 0.06));
    clip-path: inset(0 0 calc((1 - var(--p)) * 100%) 0);
    mix-blend-mode: multiply;
  }

  .beam {
    position: absolute;
    inset-inline: -10%;
    inset-block-start: calc(var(--p) * 100%);
    block-size: 3px;
    translate: 0 -50%;
    background: linear-gradient(90deg, transparent, var(--accent), var(--accent), var(--accent), transparent);
    box-shadow:
      0 0 24px 6px rgb(var(--accent-rgb) / 0.55),
      0 0 80px 20px rgb(var(--accent-rgb) / 0.25);
    opacity: calc(1 - var(--p) * var(--p) * var(--p));
  }

  .ocr-lines {
    display: grid;
    gap: 10px;
    margin: 0;
    padding: 0;
    list-style: none;
    font-family: "IBM Plex Sans Arabic", "IBM Plex Sans", sans-serif;
    font-size: clamp(0.82rem, 0.75rem + 0.3vw, 1rem);
    line-height: 1.6;
  }

  .ocr-lines li {
    --show: clamp(0, calc(var(--p) * 9 - var(--i)), 1);
    opacity: calc(0.08 + var(--show) * 0.92);
    filter: blur(calc((1 - var(--show)) * 5px));
    translate: 0 calc((1 - var(--show)) * 8px);
  }

  .ocr-lines li:first-child {
    color: var(--accent);
    font-weight: 600;
    font-size: 1.1em;
  }

  .ocr-lines mark {
    padding-inline: 3px;
    border-radius: 3px;
    background: rgb(var(--accent-rgb) / 0.18);
    color: var(--fg);
    box-shadow: inset 0 -2px 0 var(--accent);
  }

  .review-chip {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    margin-block-start: 20px;
    color: var(--accent);
    font-size: var(--step--1);
    font-weight: 600;
    opacity: clamp(0, calc(var(--p) * 4 - 3), 1);
  }

  .review-chip span {
    inline-size: 14px;
    block-size: 4px;
    border-radius: 2px;
    background: var(--accent);
  }

  /* Pipeline */
  .how {
    margin-block-start: clamp(80px, 12vw, 160px);
  }

  .how-title {
    font-size: var(--step-3);
  }

  :global(.js) .scan-demo,
  :global(.js) .pipeline {
    --p: 0;
  }

  .pipeline {
    --p: 1;
    position: relative;
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 20px;
    margin: 48px 0 0;
    padding: 0;
    list-style: none;
  }

  .pipeline-line {
    position: absolute;
    inset-block-start: 31px;
    inset-inline: 32px;
    block-size: 2px;
    background: var(--border);
  }

  .pipeline-line span {
    display: block;
    block-size: 100%;
    inline-size: calc(var(--p) * 100%);
    background: linear-gradient(90deg, var(--accent), var(--accent));
    box-shadow: 0 0 12px rgb(var(--accent-rgb) / 0.6);
  }

  :global([dir="rtl"]) .pipeline-line span {
    background: linear-gradient(270deg, var(--accent), var(--accent));
  }

  .step {
    position: relative;
  }

  .step-icon {
    position: relative;
    display: grid;
    place-items: center;
    inline-size: 64px;
    block-size: 64px;
    border: 1px solid var(--border-strong);
    border-radius: 20px;
    background: var(--surface);
    color: var(--accent);
    box-shadow: 0 0 0 8px var(--bg);
  }

  .step-icon :global(svg) {
    inline-size: 28px;
    block-size: 28px;
  }

  .step:nth-child(3) .step-icon {
    color: var(--accent);
    box-shadow:
      0 0 0 8px var(--bg),
      var(--glow);
  }

  .step h4 {
    margin-block-start: 22px;
    font-size: var(--step-1);
    font-weight: 600;
  }

  .step p {
    margin-block-start: 10px;
    color: var(--fg-muted);
    font-size: var(--step--1);
    line-height: 1.6;
  }

  :global(:lang(ar)) .step p {
    font-size: var(--step-0);
  }

  /* Private by design */
  .secure {
    display: grid;
    grid-template-columns: minmax(0, 6fr) minmax(0, 5fr);
    align-items: center;
    gap: clamp(40px, 6vw, 96px);
    margin-block-start: clamp(96px, 14vw, 180px);
  }

  .secure-diagram {
    position: relative;
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto auto;
    align-items: center;
    gap: 0;
  }

  .laptop-screen {
    position: relative;
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    align-items: center;
    gap: 10px;
    padding: 56px 22px 34px;
    border: 2px solid var(--accent);
    border-radius: 18px 18px 6px 6px;
    background:
      radial-gradient(circle at 50% 60%, rgb(var(--accent-rgb) / 0.18), transparent 70%),
      var(--surface);
    box-shadow: var(--glow);
  }

  .laptop-label {
    position: absolute;
    inset-block-start: 16px;
    inset-inline-start: 18px;
    display: inline-flex;
    align-items: center;
    gap: 6px;
    color: var(--accent);
    font-size: var(--step--1);
    font-weight: 600;
  }

  .laptop-label :global(svg) {
    inline-size: 15px;
    block-size: 15px;
  }

  .laptop-base {
    block-size: 14px;
    margin-inline: -6%;
    border-radius: 0 0 16px 16px;
    background: linear-gradient(180deg, var(--accent), var(--surface-2));
  }

  .node {
    display: grid;
    justify-items: center;
    gap: 8px;
    padding: 16px 10px;
    border: 1px solid var(--border-strong);
    border-radius: 14px;
    background: var(--bg);
    font-size: var(--step--1);
    font-weight: 600;
    text-align: center;
  }

  .node :global(svg) {
    inline-size: 30px;
    block-size: 30px;
  }

  .node-doc :global(svg) {
    color: var(--fg);
  }

  .node-model :global(svg) {
    color: var(--accent);
    animation: pulse 2.4s var(--ease-in-out) infinite;
  }

  @keyframes pulse {
    50% {
      filter: drop-shadow(0 0 10px rgb(var(--accent-rgb) / 0.9));
    }
  }

  .flow {
    position: relative;
    inline-size: clamp(40px, 6vw, 72px);
    block-size: 2px;
    background: repeating-linear-gradient(90deg, var(--border-strong) 0 6px, transparent 6px 10px);
  }

  .flow span {
    position: absolute;
    inset-block-start: 50%;
    inset-inline-start: 0;
    inline-size: 8px;
    block-size: 8px;
    translate: 0 -50%;
    border-radius: 50%;
    background: var(--accent);
    box-shadow: 0 0 10px var(--accent);
    animation: travel 2.2s linear infinite;
  }

  .flow span:nth-child(2) {
    animation-delay: 0.73s;
  }

  .flow span:nth-child(3) {
    animation-delay: 1.46s;
  }

  @keyframes travel {
    from {
      inset-inline-start: 0;
      opacity: 0;
    }

    15%,
    85% {
      opacity: 1;
    }

    to {
      inset-inline-start: calc(100% - 8px);
      opacity: 0;
    }
  }

  .cut {
    position: relative;
    display: grid;
    place-items: center;
    inline-size: clamp(70px, 9vw, 120px);
  }

  .cut-line {
    inline-size: 100%;
    block-size: 2px;
    background: repeating-linear-gradient(90deg, rgb(var(--danger-rgb) / 0.6) 0 6px, transparent 6px 12px);
  }

  .cut-x {
    position: absolute;
    display: grid;
    place-items: center;
    inline-size: 34px;
    block-size: 34px;
    border-radius: 50%;
    background: var(--danger);
    color: var(--bg);
    box-shadow: 0 0 24px rgb(var(--danger-rgb) / 0.6);
  }

  .cut-x :global(svg) {
    inline-size: 18px;
    block-size: 18px;
    stroke-width: 3;
  }

  .cut-label {
    position: absolute;
    inset-block-start: calc(50% + 26px);
    color: var(--danger);
    font-family: var(--font-mono);
    font-size: 0.78rem;
    white-space: nowrap;
  }

  :global(:lang(ar)) .cut-label {
    font-family: "IBM Plex Sans Arabic", sans-serif;
    font-size: 0.85rem;
  }

  .cloud {
    display: grid;
    justify-items: center;
    gap: 6px;
    padding: 16px;
    border: 1px dashed var(--border-strong);
    border-radius: 16px;
    color: var(--fg-dim);
    font-size: var(--step--1);
    opacity: 0.7;
  }

  .cloud :global(svg) {
    inline-size: 34px;
    block-size: 34px;
  }

  .secure-title {
    font-size: var(--step-3);
  }

  .secure-body {
    margin-block-start: 18px;
    color: var(--fg-muted);
    font-size: var(--step-1);
    line-height: 1.55;
  }

  .secure-points {
    display: grid;
    gap: 22px;
    margin-block-start: 32px;
  }

  .secure-points li {
    display: flex;
    gap: 16px;
  }

  .point-icon {
    display: grid;
    flex: none;
    place-items: center;
    inline-size: 44px;
    block-size: 44px;
    border-radius: 12px;
    background: rgb(var(--accent-rgb) / 0.12);
    color: var(--accent);
  }

  .point-icon :global(svg) {
    inline-size: 22px;
    block-size: 22px;
  }

  .secure-points h4 {
    font-size: var(--step-0);
    font-weight: 600;
  }

  .secure-points p {
    margin-block-start: 4px;
    color: var(--fg-muted);
    font-size: var(--step--1);
  }

  :global(:lang(ar)) .secure-points p {
    font-size: var(--step-0);
  }

  /* Stats */
  .stats {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    margin-block-start: clamp(80px, 12vw, 160px);
    border-block: 1px solid var(--border);
  }

  .stats li {
    display: grid;
    gap: 10px;
    padding: 40px 24px;
  }

  .stats li + li {
    border-inline-start: 1px solid var(--border);
  }

  .stat-value {
    font-family: var(--font-display);
    font-size: var(--step-5);
    font-weight: 600;
    line-height: 1;
    background: linear-gradient(135deg, var(--accent), var(--accent) 50%, var(--accent));
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
  }

  .stat-label {
    max-inline-size: 28ch;
    color: var(--fg-muted);
  }

  .ocr-shot {
    display: grid;
    gap: 32px;
    margin-block-start: clamp(64px, 10vw, 120px);
  }

  .accuracy {
    max-inline-size: 60ch;
    margin-inline: auto;
    color: var(--fg-muted);
    font-size: var(--step-1);
    text-align: center;
  }

  @media (max-width: 960px) {
    .pipeline {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      row-gap: 48px;
    }

    .pipeline-line {
      display: none;
    }

    .secure {
      grid-template-columns: minmax(0, 1fr);
    }
  }

  @media (max-width: 720px) {
    .scan-demo {
      grid-template-columns: minmax(0, 1fr);
    }

    .stats {
      grid-template-columns: minmax(0, 1fr);
    }

    .stats li + li {
      border-inline-start: 0;
      border-block-start: 1px solid var(--border);
    }

    .secure-diagram {
      grid-template-columns: minmax(0, 1fr);
      justify-items: center;
      gap: 40px;
    }

    .laptop {
      inline-size: 100%;
    }

    .cut {
      inline-size: 2px;
      block-size: 70px;
    }

    .cut-line {
      inline-size: 2px;
      block-size: 100%;
      background: repeating-linear-gradient(180deg, rgb(var(--danger-rgb) / 0.6) 0 6px, transparent 6px 12px);
    }

    .cut-label {
      inset-block-start: 50%;
      inset-inline-start: 32px;
      translate: 0 -50%;
    }
  }

  @media (max-width: 480px) {
    .pipeline {
      grid-template-columns: minmax(0, 1fr);
    }

    .laptop-screen {
      grid-template-columns: minmax(0, 1fr);
      justify-items: stretch;
    }

    .flow {
      justify-self: center;
      inline-size: 2px;
      block-size: 36px;
      background: repeating-linear-gradient(180deg, var(--border-strong) 0 6px, transparent 6px 10px);
    }

    .flow span {
      display: none;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    :global(.js) .scan-demo,
    :global(.js) .pipeline {
      --p: 1;
    }

    .flow span,
    .node-model :global(svg) {
      animation: none;
    }
  }
</style>
