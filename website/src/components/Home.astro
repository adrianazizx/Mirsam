---
import Base from "../layouts/Base.astro";
import { type Lang, strings } from "../lib/i18n";
import Arabic from "./Arabic.astro";
import Download from "./Download.astro";
import Features from "./Features.astro";
import Footer from "./Footer.astro";
import Header from "./Header.astro";
import Hero from "./Hero.astro";
import Marquee from "./Marquee.astro";
import Ocr from "./Ocr.astro";
import Privacy from "./Privacy.astro";

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
---

<Base lang={lang}>
  <a class="skip-link" href="#main">{strings[lang].nav.skip}</a>
  <Header lang={lang} />
  <main id="main">
    <Hero lang={lang} />
    <Marquee lang={lang} />
    <Features lang={lang} />
    <Arabic lang={lang} />
    <Ocr lang={lang} />
    <Privacy lang={lang} />
    <Download lang={lang} />
  </main>
  <Footer lang={lang} />
</Base>
